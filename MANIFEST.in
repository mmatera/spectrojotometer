# Source distribution: documentation, examples and tests, besides the package.
include README.md README.rst CHANGES.rst AUTHORS.txt COPYNG.txt
include logo.svg logo.gif spectrojotometer.ico
recursive-include examples *
recursive-include tests *.py *.cif *.struct *.md
recursive-include spectrojotometer/doc *
global-exclude __pycache__ *.py[cod]
